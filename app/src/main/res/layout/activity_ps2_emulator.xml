<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Màn hình kết xuất game phần cứng Vulkan / OpenGL ES 3.2 -->
    <SurfaceView
        android:id="@+id/surfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Lớp phủ OSD hiển thị FPS / VPS / Speed% như PCSX2 GS OSD -->
    <TextView
        android:id="@+id/tvOsdFps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="14dp"
        android:layout_marginTop="52dp"
        android:background="#BB101018"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:text="FPS: 60.0 | VPS: 60.0 (100%)"
        android:textColor="#00FF66"
        android:fontFamily="monospace"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="visible" />

    <!-- Banner hiển thị thông tin tệp game PS2 đang chạy -->
    <LinearLayout
        android:id="@+id/layoutGameBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="52dp"
        android:layout_marginEnd="14dp"
        android:background="#BB101018"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <TextView
            android:id="@+id/tvGameBannerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PS2 Game"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvGameBannerStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đang nạp vào Virtual Machine..."
            android:textColor="#00E5FF"
            android:fontFamily="monospace"
            android:textSize="10sp" />

    </LinearLayout>

    <!-- Lớp phủ hệ thống nút điều khiển ảo cảm ứng DamonPS2 PRO -->
    <com.ps2t.emulator.ui.PS2TouchControllerView
        android:id="@+id/touchControllerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Nút thu nhỏ / mở rộng Menu HUD ở đỉnh màn hình -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_gravity="top|center_horizontal">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="#AA111118"
            android:orientation="horizontal"
            android:padding="2dp">

            <Button
                android:id="@+id/btnTurbo"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="3dp"
                android:backgroundTint="#88333333"
                android:text="@string/hud_turbo"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp" />

            <Button
                android:id="@+id/btnPause"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="3dp"
                android:backgroundTint="#88333333"
                android:text="@string/hud_pause"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp" />

            <Button
                android:id="@+id/btnStateSlot"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="3dp"
                android:backgroundTint="#88444455"
                android:text="Slot 0"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp" />

            <Button
                android:id="@+id/btnSaveState"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="3dp"
                android:backgroundTint="#88333333"
                android:text="@string/save_state"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp" />

            <Button
                android:id="@+id/btnLoadState"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="3dp"
                android:backgroundTint="#88333333"
                android:text="@string/load_state"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp" />

            <Button
                android:id="@+id/btnScreenshot"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="3dp"
                android:backgroundTint="#88333333"
                android:text="@string/hud_screenshot"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp" />

            <Button
                android:id="@+id/btnSettings"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="3dp"
                android:backgroundTint="#88333333"
                android:text="@string/hud_settings"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp" />

            <Button
                android:id="@+id/btnToggleGamepad"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="3dp"
                android:backgroundTint="#88333333"
                android:text="@string/toggle_gamepad"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp" />

            <Button
                android:id="@+id/btnBackToHome"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:backgroundTint="#88882222"
                android:text="@string/back_to_menu"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp" />

        </LinearLayout>

        <!-- Nút ghim/thu gọn thanh công cụ -->
        <TextView
            android:id="@+id/btnCollapseHud"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#66000000"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="▲ Ẩn menu"
            android:textColor="#AAAAAA"
            android:textSize="9sp" />

    </LinearLayout>

</FrameLayout>
