<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ps_bg"
    android:orientation="vertical">

    <!-- Header của hộp thoại cài đặt -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/ps_card"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CÀI ĐẶT CỐT LÕI PCSX2"
            android:textColor="@color/ps_blue_light"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCloseSettings"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="@color/ps_blue"
            android:text="LƯU &amp; ĐÓNG"
            android:textColor="@color/white"
            android:textSize="12sp"
            app:cornerRadius="6dp" />

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ============================================== -->
            <!-- 1. NHÓM ĐỒ HỌA (GS - GRAPHICS) -->
            <!-- ============================================== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. ĐỒ HỌA (GRAPHICS SYNTHESIZER)"
                android:textColor="@color/ps_cross"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/ps_card"
                app:cardCornerRadius="10dp"
                app:strokeColor="@color/ps_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Độ phân giải nội bộ (Upscaling Multiplier):"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <Spinner
                        android:id="@+id/spinnerResolution"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="10dp"
                        android:backgroundTint="@color/white" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Lọc đẳng hướng (Anisotropic Filtering):"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <Spinner
                        android:id="@+id/spinnerAnisotropic"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="10dp"
                        android:backgroundTint="@color/white" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchFxaa"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Khử răng cưa hậu kỳ (Anti-Aliasing FXAA)"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchOsdFps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Hiển thị chỉ số OSD (FPS, VPS, Tốc độ %)"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:checked="true" />

                    <TextView
                        android:id="@+id/tvCasSharpnessLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Độ nét AMD FidelityFX CAS: 50%"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:layout_marginTop="8dp" />

                    <SeekBar
                        android:id="@+id/seekCasSharpness"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="50"
                        android:progressTint="@color/ps_cross"
                        android:thumbTint="@color/ps_cross" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ============================================== -->
            <!-- 2. HIỆU NĂNG & SPEEDHACKS -->
            <!-- ============================================== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. HIỆU NĂNG &amp; SPEEDHACKS"
                android:textColor="@color/status_orange"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/ps_card"
                app:cardCornerRadius="10dp"
                app:strokeColor="@color/ps_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchMtvu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="MTVU (Multi-Threaded microVU1 - Tăng tốc CPU đa nhân)"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:checked="true" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchFastCdvd"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Fast CDVD (Đọc đĩa nhanh, giảm thời gian load)"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:checked="true" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="EE Cycle Rate (Ép xung/Hạ xung CPU):"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:layout_marginTop="8dp" />

                    <Spinner
                        android:id="@+id/spinnerEeCycleRate"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:backgroundTint="@color/white" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="EE Cycle Skip (Nhảy khung hình khi lag):"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:layout_marginTop="8dp" />

                    <Spinner
                        android:id="@+id/spinnerEeCycleSkip"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:backgroundTint="@color/white" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ============================================== -->
            <!-- 3. BẢN VÁ & CHEATS (PATCHES & CHEATS) -->
            <!-- ============================================== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. BẢN VÁ MÀN HÌNH RỘNG &amp; GIAN LẬN"
                android:textColor="@color/ps_triangle"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/ps_card"
                app:cardCornerRadius="10dp"
                app:strokeColor="@color/ps_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchWidescreenPatch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Bản vá Màn ảnh rộng (16:9 Widescreen Patches)"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:checked="true" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchNoInterlace"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Bản vá Khử rung quét dòng (No-Interlacing Patches)"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:checked="true" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchCheats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Kích hoạt Mã gian lận (Enable Cheats .pnach)"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchGameFixes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tự động sửa lỗi tương thích (Automatic GameFixes)"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:checked="true" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ============================================== -->
            <!-- 4. ÂM THANH SPU2 -->
            <!-- ============================================== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="4. ÂM THANH (SPU2 AUDIO)"
                android:textColor="@color/ps_square"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/ps_card"
                app:cardCornerRadius="10dp"
                app:strokeColor="@color/ps_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchTimeStretch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Kéo giãn thời gian (TimeStretch - chống xé/rè âm thanh)"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:checked="true" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchMute"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tắt toàn bộ âm thanh (Mute Audio)"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvVolumeLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Âm lượng: 100%"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:layout_marginTop="8dp" />

                    <SeekBar
                        android:id="@+id/seekVolume"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="100"
                        android:progressTint="@color/ps_square"
                        android:thumbTint="@color/ps_square" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ============================================== -->
            <!-- 5. TÙY BIẾN PHÍM CẢM ỨNG & THẺ NHỚ -->
            <!-- ============================================== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="5. TÙY BIẾN NÚT ẢO &amp; THẺ NHỚ"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/ps_card"
                app:cardCornerRadius="10dp"
                app:strokeColor="@color/ps_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/tvOpacityLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Độ mờ phím ảo (Opacity): 80%"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <SeekBar
                        android:id="@+id/seekOpacity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="80"
                        android:progressTint="@color/ps_blue_light"
                        android:thumbTint="@color/ps_blue_light" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchHaptic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Rung phản hồi xúc giác khi nhấn phím (Haptic)"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:checked="true"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Thẻ nhớ PS2: Đã kích hoạt 2 thẻ 8MB (Mcd001.ps2, Mcd002.ps2)"
                        android:textColor="@color/status_green"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
